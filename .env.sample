# 复制为 .env 后填入自己的值:
#   cp .env.sample .env && vi .env
# 或者直接跑 sudo ./sss.sh <TG_CHAT_ID> <TG_BOT_TOKEN>, 脚本会自动生成 .env
#
# TG_BOT_TOKEN: 找 @BotFather 创建机器人获取
# TG_CHAT_ID  : 找 @getuserID 获取
#
# 留空则 bot 容器照常运行, 只是发不出通知。

TG_CHAT_ID=
TG_BOT_TOKEN=

# ---- 端口(改完执行 docker compose up -d 生效) ----

# 面板 web 端口, 浏览器访问 http://<IP>:<WEB_PORT>
WEB_PORT=8081

# agent 上报端口。
# !! 只在面板还没有任何 agent 接入时改, 已经有 agent 在跑就别动 !!
#    改了之后所有已装 agent 都连不上, 会全部显示离线, 得挨台重装。
# 另外, 改成非 35601 后, agent 安装命令不会自动带上新端口, 装完要手动补:
#    编辑 /etc/systemd/system/sss-agent.service, 在 ExecStart 行末尾加 PORT=<端口>
#    然后 systemctl daemon-reload && systemctl restart sss-agent
REPORT_PORT=35601
