# 复制为 .env 后填入自己的值:
#   cp .env.sample .env && vi .env
# 或者直接跑 sudo ./sss.sh <TG_CHAT_ID> <TG_BOT_TOKEN>, 脚本会自动生成 .env
#
# TG_BOT_TOKEN: 找 @BotFather 创建机器人获取
# TG_CHAT_ID  : 找 @getuserID 获取
#
# 留空则 bot 容器照常运行, 只是发不出通知。

TG_CHAT_ID=
TG_BOT_TOKEN=

# 面板 web 端口, 浏览器访问 http://<IP>:<WEB_PORT>
# 改完执行 docker compose up -d 生效。
# (agent 上报端口 35601 写死在 docker-compose.yml, 改了已装的 agent 会全部掉线, 别动)
WEB_PORT=8081
